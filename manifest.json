{
  "manifest_version": 3,
  "name": "ChatClock",
  "version": "0.1.1",
  "description": "Show your chat partner's local time. Currently supports Instagram and Discord.",
  "icons": {
    "16": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "https://discord.com/*"],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://discord.com/*"],
      "js": [
        "content/adapters/base.js",
        "content/adapters/instagram.js",
        "content/adapters/discord.js",
        "content/adapters/index.js",
        "content/contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/timezones.json"],
      "matches": ["https://www.instagram.com/*", "https://discord.com/*"]
    }
  ]
}
